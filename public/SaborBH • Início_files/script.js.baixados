    "fb.all_reviews": "Lo que dicen",
    "fb.success": "¡Gracias! Tu opinión fue enviada.",
    "fb.err_rating": "Elige una nota de 1 a 5 estrellas.", "fb.err_comment": "Escribe un comentario antes de enviar.",
    "profile.visits":"visitas","profile.reviews":"opiniones","profile.photos":"fotos",
    "profile.tab.visits":"Visitados","profile.tab.reviews":"Mis opiniones","profile.tab.photos":"Fotos",
    "profile.empty_visits":"Aún no has visitado ningún restaurante. Ve a la página inicial y pulsa \"Detalles\" para registrar una visita.",
    "profile.empty_reviews":"Aún no has enviado opiniones.",
    "profile.empty_photos":"Aún no hay fotos.",
    "about.title":"Sobre el proyecto", "about.sub":"Una plataforma para conectar a las personas con los mejores sabores de Belo Horizonte.",
    "footer.made":"Hecho con sabor para la Semana 6 📚",
    "login.err":"Correo o contraseña incorrectos.",
    "signup.err_email":"Este correo ya está registrado.",
    "signup.err_fields":"Rellena todos los campos correctamente."
  }
};

/* ---------- STORAGE HELPERS ---------- */
const LS = {
  get: (k, def=null) => { try { return JSON.parse(localStorage.getItem(k)) ?? def; } catch { return def; } },
  set: (k, v) => localStorage.setItem(k, JSON.stringify(v)),
  remove: (k) => localStorage.removeItem(k)
};

function currentUser() { return LS.get("sabor_user"); }
function requireAuth() {
  if (!currentUser()) { window.location.href = "index.html"; return false; }
  return true;
}

/* ---------- LANG ---------- */
function getLang() { return LS.get("sabor_lang", "pt"); }
function setLang(lang) {
  LS.set("sabor_lang", lang);
  document.documentElement.setAttribute("lang", lang === "pt" ? "pt-BR" : lang);
  document.querySelectorAll("[data-i18n]").forEach(el => {
    const k = el.getAttribute("data-i18n");
    const t = (I18N[lang] && I18N[lang][k]) || I18N.pt[k] || k;
    if (/<.*>/.test(t)) el.innerHTML = t; else el.textContent = t;
  });
  document.querySelectorAll(".lang-btn").forEach(b => {
    b.classList.toggle("active", b.getAttribute("data-lang") === lang);
  });
}
function tr(key) { return (I18N[getLang()] && I18N[getLang()][key]) || I18N.pt[key] || key; }

function attachLangSwitches() {
  document.querySelectorAll(".lang-btn").forEach(b => {
    b.addEventListener("click", () => setLang(b.getAttribute("data-lang")));
  });
}

/* ---------- COMMON INIT ---------- */
function initCommon() {
  attachLangSwitches();
  setLang(getLang());
  const out = document.getElementById("logoutBtn");
  if (out) out.addEventListener("click", () => { LS.remove("sabor_user"); window.location.href = "index.html"; });
  // Guard pages that require auth
  const file = window.location.pathname.split("/").pop() || "index.html";
  const guarded = ["home.html","feedback.html","perfil.html","restaurante.html","sobre.html"];
  if (guarded.includes(file)) requireAuth();
}

/* ---------- LOGIN ---------- */
function initLogin() {
  attachLangSwitches();
  setLang(getLang());
  if (currentUser()) { window.location.href = "home.html"; return; }

  const form = document.getElementById("loginForm");
  const err = document.getElementById("loginError");
  const togglePass = document.querySelector(".toggle-pass");
  const pwdInput = document.getElementById("loginPassword");

  if (togglePass) togglePass.addEventListener("click", () => {
    pwdInput.type = pwdInput.type === "password" ? "text" : "password";
    togglePass.innerHTML = pwdInput.type === "password" ? '<i class="fa-regular fa-eye"></i>' : '<i class="fa-regular fa-eye-slash"></i>';
  });

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    err.classList.add("d-none");
    const email = document.getElementById("loginEmail").value.trim().toLowerCase();
    const pwd = document.getElementById("loginPassword").value;
    const users = LS.get("sabor_users", []);
    const u = users.find(x => x.email === email && x.password === pwd);
    if (!u) { err.textContent = tr("login.err"); err.classList.remove("d-none"); return; }
    LS.set("sabor_user", { name: u.name, email: u.email });
    window.location.href = "home.html";
  });

  document.getElementById("demoLogin").addEventListener("click", () => {
    LS.set("sabor_user", { name: "Convidado", email: "guest@saborbh.app", guest: true });
    window.location.href = "home.html";
  });
}

/* ---------- SIGNUP ---------- */
function initSignup() {
  attachLangSwitches();
  setLang(getLang());
  const form = document.getElementById("signupForm");
  const err = document.getElementById("signupError");
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    err.classList.add("d-none");
    const name = document.getElementById("signupName").value.trim();
    const email = document.getElementById("signupEmail").value.trim().toLowerCase();
    const pwd = document.getElementById("signupPassword").value;
    if (!name || !email || pwd.length < 4) {
      err.textContent = tr("signup.err_fields"); err.classList.remove("d-none"); return;
    }
    const users = LS.get("sabor_users", []);
    if (users.find(u => u.email === email)) {
      err.textContent = tr("signup.err_email"); err.classList.remove("d-none"); return;
    }
    users.push({ name, email, password: pwd });
    LS.set("sabor_users", users);
    LS.set("sabor_user", { name, email });
    window.location.href = "home.html";
  });
}

/* ---------- STAR RENDERING ---------- */
function renderStars(rating) {
  const full = Math.floor(rating);
  const half = rating - full >= 0.5;
  let html = "";
  for (let i=0;i<full;i++) html += '<i class="fa-solid fa-star"></i>';
  if (half) html += '<i class="fa-solid fa-star-half-stroke"></i>';
  for (let i=full+(half?1:0); i<5; i++) html += '<i class="fa-regular fa-star"></i>';
  return html;
}

/* ---------- HOME ---------- */
function initHome() {
  initCommon();
  const lang = getLang();
  const grid = document.getElementById("restaurantGrid");
  const recent = document.getElementById("recentList");
  const chips = document.getElementById("typeChips");
  const countEl = document.getElementById("resultCount");
  const searchForm = document.getElementById("searchForm");
  const searchInput = document.getElementById("searchInput");

  let activeFilter = "all";
  let searchTerm = "";

  // build chips
  const types = [...new Set(RESTAURANTS.map(r => r.type))];
  const chipLabels = { pt:{all:"Todos"}, en:{all:"All"}, es:{all:"Todos"} };
  chips.innerHTML = `<button class="chip active" data-type="all">${chipLabels[lang].all}</button>` +
    types.map(t => {
      const sample = RESTAURANTS.find(r => r.type === t);
      return `<button class="chip" data-type="${t}">${sample.typeLabel[lang]}</button>`;
    }).join("");

  chips.querySelectorAll(".chip").forEach(c => c.addEventListener("click", () => {
    chips.querySelectorAll(".chip").forEach(x => x.classList.remove("active"));
    c.classList.add("active");
    activeFilter = c.getAttribute("data-type");
    render();
  }));

  function render() {
    const l = getLang();
    const list = RESTAURANTS.filter(r => {
      const matchesType = activeFilter === "all" || r.type === activeFilter;
      const hay = (r.name + " " + r.typeLabel[l] + " " + r.address).toLowerCase();
      const matchesSearch = !searchTerm || hay.includes(searchTerm);
      return matchesType && matchesSearch;
    });
    countEl.textContent = list.length + " " + (list.length === 1 ? "resultado" : "resultados");
    grid.innerHTML = list.map(r => cardHTML(r, l)).join("") ||
      `<div class="col-12 text-center py-5 text-muted-soft">Nenhum restaurante encontrado.</div>`;
    // init bootstrap carousels
    grid.querySelectorAll(".carousel").forEach(el => new bootstrap.Carousel(el, { interval: false }));
  }

  function cardHTML(r, l) {
    const musicTxt = r.band ? tr("detail.music") : (l==="en"?"No live music":l==="es"?"Sin música en vivo":"Sem música ao vivo");
    return `
    <div class="col-12 col-md-6 col-xl-4">
      <article class="r-card" data-testid="r-card-${r.id}">
        <div class="card-img-wrap position-relative">
          <span class="cat-badge cat-${r.type}">${r.typeLabel[l]}</span>
          <span class="music-pill ${r.band?"has":""}">
            <i class="fa-solid ${r.band?"fa-music":"fa-volume-xmark"}"></i> ${musicTxt}
          </span>
          <div id="car-${r.id}" class="carousel slide" data-bs-ride="false">
            <div class="carousel-inner">
              ${r.photos.map((p,i)=>`<div class="carousel-item ${i===0?"active":""}"><img src="${p}" alt="${r.name}"/></div>`).join("")}
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#car-${r.id}" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
            <button class="carousel-control-next" type="button" data-bs-target="#car-${r.id}" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
          </div>
        </div>
        <div class="r-body">
          <h4 class="r-name">${r.name}</h4>
          <p class="r-address"><i class="fa-solid fa-location-dot"></i> ${r.address}</p>
          <div class="r-stars">${renderStars(r.rating)}<span class="rnum">${r.rating.toFixed(1)}</span></div>
          <p class="r-desc">${r.desc[l]}</p>
          <div class="r-actions">
            <a class="btn btn-brand" href="/restaurante.html?id=${r.id}" data-testid="btn-details-${r.id}"><i class="fa-solid fa-circle-info me-1"></i>Detalhes</a>
            <a class="btn btn-outline-brick" href="/feedback.html?id=${r.id}" data-testid="btn-feedback-${r.id}"><i class="fa-regular fa-comment-dots me-1"></i>Feedback</a>
          </div>
        </div>
      </article>
    </div>`;
  }

  searchForm.addEventListener("submit", (e) => {
    e.preventDefault();
    searchTerm = searchInput.value.trim().toLowerCase();
    render();
  });
  searchInput.addEventListener("input", (e) => { searchTerm = e.target.value.trim().toLowerCase(); render(); });

  recent.innerHTML = RECENT_ADDITIONS.map(x => `<li><i class="fa-solid fa-sparkles text-warning"></i> ${x}</li>`).join("");

  render();

  // re-render on lang switch
  document.querySelectorAll(".lang-btn").forEach(b => b.addEventListener("click", () => render()));
}

/* ---------- DETAIL ---------- */
function initDetail() {
  initCommon();
  const id = new URLSearchParams(window.location.search).get("id");
  const r = RESTAURANTS.find(x => x.id === id) || RESTAURANTS[0];
  const l = getLang();
  const user = currentUser();

  // register visit
  if (user) {
    const visits = LS.get("sabor_visits_"+user.email, []);
    if (!visits.includes(r.id)) { visits.push(r.id); LS.set("sabor_visits_"+user.email, visits); }
  }

  const container = document.getElementById("detailContent");
  container.innerHTML = `
    <div class="detail-hero">
      <div id="carDetail" class="carousel slide" data-bs-ride="false">
        <div class="carousel-inner">
          ${r.photos.map((p,i)=>`<div class="carousel-item ${i===0?"active":""}"><img src="${p}" alt="${r.name}"/></div>`).join("")}
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carDetail" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
        <button class="carousel-control-next" type="button" data-bs-target="#carDetail" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
        <div class="carousel-indicators">
          ${r.photos.map((_,i)=>`<button type="button" data-bs-target="#carDetail" data-bs-slide-to="${i}" ${i===0?"class='active'":""}></button>`).join("")}
        </div>
      </div>
      <div class="detail-meta">
        <div class="d-flex justify-content-between flex-wrap gap-2">
          <h1>${r.name}</h1>
          <span class="type-badge-display">${r.typeLabel[l]}</span>
        </div>
        <div class="stars">${renderStars(r.rating)} <span class="rnum ms-2">${r.rating.toFixed(1)}</span></div>
        <div class="meta-row">
          <span class="meta-chip"><i class="fa-solid fa-location-dot"></i> ${r.address}</span>
          <span class="meta-chip ${r.band?"yes":"no"}"><i class="fa-solid ${r.band?"fa-music":"fa-volume-xmark"}"></i>
            ${r.band ? (l==="en"?"Live music":l==="es"?"Música en vivo":"Música ao vivo") : (l==="en"?"No live music":l==="es"?"Sin música en vivo":"Sem música ao vivo")}
          </span>
          <span class="meta-chip"><i class="fa-solid fa-utensils"></i> ${r.typeLabel[l]}</span>
        </div>
        <p class="text-muted-soft">${r.desc[l]}</p>
        <a href="/feedback.html?id=${r.id}" class="btn btn-brand mt-2" data-testid="detail-fb-btn"><i class="fa-regular fa-comment-dots me-2"></i>${tr("detail.send_fb")}</a>
      </div>
    </div>

    <div class="detail-grid">
      <div class="info-card" data-testid="menu-card">
        <h3><i class="fa-solid fa-book-open"></i> ${tr("detail.menu")}</h3>
        <ul class="menu-list">
          ${r.menu.map(m => `
            <li>
              <div>
                <div class="item-name">${m.name[l]}</div>
                <div class="item-desc">${m.desc[l]}</div>
              </div>
              <div class="item-price">${m.price}</div>
            </li>`).join("")}
        </ul>
      </div>
      <div class="info-card" data-testid="map-card">
        <h3><i class="fa-solid fa-map-location-dot"></i> ${tr("detail.location")}</h3>
        <div id="mapBox"></div>
        <p class="text-muted-soft mt-2 mb-0"><i class="fa-solid fa-location-dot me-1"></i>${r.address}</p>
      </div>
    </div>
  `;

  // init carousel
  new bootstrap.Carousel(document.getElementById("carDetail"), { interval: 5000 });

  // init leaflet map
  const map = L.map("mapBox", { scrollWheelZoom: false }).setView(r.coords, 16);
  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution: '&copy; OpenStreetMap'
  }).addTo(map);
  const redIcon = L.divIcon({
    className: "sabor-marker",
    html: `<div style="background:linear-gradient(135deg,#ff7a3d,#c0392b);width:34px;height:34px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);box-shadow:0 4px 12px rgba(0,0,0,.3);border:3px solid #fff;display:grid;place-items:center"><i class="fa-solid fa-utensils" style="color:#fff;transform:rotate(45deg)"></i></div>`,
    iconSize: [34,34], iconAnchor: [17, 34]
  });
  L.marker(r.coords, { icon: redIcon }).addTo(map).bindPopup(`<strong>${r.name}</strong><br>${r.address}`).openPopup();
}

/* ---------- FEEDBACK ---------- */
function initFeedback() {
  initCommon();
  const sel = document.getElementById("fbRestaurant");
  const typeDisp = document.getElementById("typeDisplay");
  const starsBox = document.getElementById("fbStars");
  const ratingLabel = document.getElementById("ratingLabel");
  const errBox = document.getElementById("fbError");
  const okBox = document.getElementById("fbSuccess");
  const commentEl = document.getElementById("fbComment");
  const submitBtn = document.getElementById("fbSubmit");
  const list = document.getElementById("reviewsList");

  let rating = 0;

  function renderSelect() {
    const l = getLang();
    sel.innerHTML = RESTAURANTS.map(r => `<option value="${r.id}">${r.name} · ${r.typeLabel[l]}</option>`).join("");
    const urlId = new URLSearchParams(window.location.search).get("id");
    if (urlId && RESTAURANTS.find(x=>x.id===urlId)) sel.value = urlId;
    onSelect();
  }

  function onSelect() {
    const r = RESTAURANTS.find(x => x.id === sel.value);
    typeDisp.innerHTML = `<i class="fa-solid fa-bowl-food"></i> ${r.typeLabel[getLang()]}`;
    renderReviews();
  }

  function setRating(v) {
    rating = v;
    starsBox.querySelectorAll(".star").forEach(s => {
      const val = +s.getAttribute("data-value");
      s.classList.toggle("active", val <= rating);
      s.classList.toggle("fa-solid", val <= rating);
      s.classList.toggle("fa-regular", val > rating);
    });
    ratingLabel.textContent = `${rating} / 5`;
  }

  starsBox.querySelectorAll(".star").forEach(s => {
    s.addEventListener("click", () => setRating(+s.getAttribute("data-value")));
    s.addEventListener("mouseenter", () => {
      const v = +s.getAttribute("data-value");
      starsBox.querySelectorAll(".star").forEach(x => {
        const xv = +x.getAttribute("data-value");
        x.classList.toggle("active", xv <= v);
        x.classList.toggle("fa-solid", xv <= v);
        x.classList.toggle("fa-regular", xv > v);
      });
    });
    s.addEventListener("mouseleave", () => setRating(rating));
  });

  sel.addEventListener("change", onSelect);

  submitBtn.addEventListener("click", () => {
    errBox.classList.add("d-none"); okBox.classList.add("d-none");
    if (rating < 1) { errBox.textContent = tr("fb.err_rating"); errBox.classList.remove("d-none"); return; }
    const comment = commentEl.value.trim();
    if (!comment) { errBox.textContent = tr("fb.err_comment"); errBox.classList.remove("d-none"); return; }
    const user = currentUser() || { name: "Convidado", email: "guest" };
    const userReviews = LS.get("sabor_reviews", []);
    userReviews.push({
      restaurantId: sel.value,
      author: user.name,
      email: user.email,
      rating, text: comment,
      date: new Date().toLocaleDateString(getLang() === "pt" ? "pt-BR" : (getLang()==="es"?"es-ES":"en-US"), { day:"2-digit", month:"short", year:"numeric" })
    });
    LS.set("sabor_reviews", userReviews);
    okBox.textContent = tr("fb.success");
    okBox.classList.remove("d-none");
    commentEl.value = ""; setRating(0);
    renderReviews();
  });

  function renderReviews() {
    const l = getLang();
    const userReviews = LS.get("sabor_reviews", []);
    const all = [
      ...userReviews.filter(r => r.restaurantId === sel.value),
      ...SEED_REVIEWS.filter(r => r.restaurantId === sel.value)
    ];
    if (!all.length) {
      list.innerHTML = `<div class="text-muted-soft text-center py-4">${l==="en"?"No reviews yet. Be the first!":l==="es"?"Sin opiniones aún. ¡Sé el primero!":"Sem avaliações ainda. Seja o primeiro!"}</div>`;
      return;
    }
    list.innerHTML = all.map(rv => {
      const rest = RESTAURANTS.find(x => x.id === rv.restaurantId);
      const initial = (rv.author || "?").charAt(0).toUpperCase();
      return `
        <article class="review-card" data-testid="review-card">
          <div class="review-head">
            <div class="review-avatar">${initial}</div>
            <div>
              <p class="review-author">${rv.author}</p>
              <span class="review-meta">${rv.date || ""}</span>
            </div>
            <div class="review-stars">${renderStars(rv.rating)}</div>
          </div>
          <p class="review-text">${rv.text}</p>
          <span class="review-restaurant"><i class="fa-solid fa-utensils me-1"></i>${rest ? rest.name + " · " + rest.typeLabel[l] : ""}</span>
        </article>`;
    }).join("");
  }

  renderSelect();
  document.querySelectorAll(".lang-btn").forEach(b => b.addEventListener("click", () => { renderSelect(); }));
}

/* ---------- PROFILE ---------- */
function initProfile() {
  initCommon();
  const user = currentUser();
  if (!user) return;
  const l = getLang();

  document.getElementById("profileName").textContent = user.name;
  document.getElementById("profileEmail").textContent = user.email;
  document.getElementById("profileAvatar").textContent = (user.name || "?").charAt(0).toUpperCase();

  const visits = LS.get("sabor_visits_"+user.email, []);
  const allReviews = LS.get("sabor_reviews", []);
  const myReviews = allReviews.filter(r => r.email === user.email);

  const visitedRests = visits.map(id => RESTAURANTS.find(r => r.id === id)).filter(Boolean);
  const allPhotos = visitedRests.flatMap(r => r.photos);

  document.getElementById("statVisits").textContent = visits.length;
  document.getElementById("statReviews").textContent = myReviews.length;
  document.getElementById("statPhotos").textContent = allPhotos.length;

  const vGrid = document.getElementById("visitsGrid");
  vGrid.innerHTML = visitedRests.length
    ? visitedRests.map(r => `
        <div class="col-12 col-md-6 col-lg-4">
          <article class="r-card">
            <div class="card-img-wrap position-relative">
              <span class="cat-badge cat-${r.type}">${r.typeLabel[l]}</span>
              <img src="${r.photos[0]}" alt="${r.name}" style="width:100%;aspect-ratio:16/10;object-fit:cover"/>
            </div>
            <div class="r-body">
              <h4 class="r-name">${r.name}</h4>
              <p class="r-address"><i class="fa-solid fa-location-dot"></i> ${r.address}</p>
              <div class="r-stars">${renderStars(r.rating)}<span class="rnum">${r.rating.toFixed(1)}</span></div>
              <a class="btn btn-outline-brick mt-auto" href="/restaurante.html?id=${r.id}"><i class="fa-solid fa-eye me-1"></i>Ver</a>
            </div>
          </article>
        </div>`).join("")
    : `<div class="col-12 text-center text-muted-soft py-5">${tr("profile.empty_visits")}</div>`;

  const rBox = document.getElementById("myReviews");
  rBox.innerHTML = myReviews.length
    ? `<div class="reviews-list">${myReviews.map(rv => {
        const r = RESTAURANTS.find(x => x.id === rv.restaurantId);
        const initial = (rv.author || "?").charAt(0).toUpperCase();
        return `<article class="review-card">
          <div class="review-head">
            <div class="review-avatar">${initial}</div>
            <div><p class="review-author">${rv.author}</p><span class="review-meta">${rv.date}</span></div>
            <div class="review-stars">${renderStars(rv.rating)}</div>
          </div>
          <p class="review-text">${rv.text}</p>
          <span class="review-restaurant"><i class="fa-solid fa-utensils me-1"></i>${r ? r.name : ""}</span>
        </article>`;
      }).join("")}</div>`
    : `<div class="text-center text-muted-soft py-5">${tr("profile.empty_reviews")}</div>`;

  const pGrid = document.getElementById("photosGrid");
  pGrid.innerHTML = allPhotos.length
    ? allPhotos.map(p => `<img src="${p}" alt="foto"/>`).join("")
    : `<div class="text-muted-soft py-5 text-center w-100">${tr("profile.empty_photos")}</div>`;
}
